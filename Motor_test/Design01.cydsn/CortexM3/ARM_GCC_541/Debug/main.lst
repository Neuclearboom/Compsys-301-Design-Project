   1:main.c        **** /* ==========================================================================
   2:main.c        ****  * Line-Following Robot
   3:main.c        ****  * ==========================================================================
   4:main.c        ****  * Sensor pins:
   5:main.c        ****  *   S1 = P1.5    S2 = P1.6    S3 = P1.7
   6:main.c        ****  *   S4 = P2.5    S5 = P2.6    S6 = P2.7
   7:main.c        ****  *
   8:main.c        ****  * Physical role assignment:
   9:main.c        ****  *   S3 = front-left     S2 = front-right
  10:main.c        ****  *   S6 = mid            S4 = back
  11:main.c        ****  *   S5 = left           S1 = right   (swapped - matched turning the correct
  12:main.c        ****  *                                     direction on the bench)
  13:main.c        ****  * ========================================================================== */
